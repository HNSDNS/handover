{
  "name": "handover",
  "version": "2.0.0",
  "description": "hsd plugin to resolve names on other networks like ENS and Namecoin",
  "type": "module",
  "main": "src/handover.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "HANDOVER_RPC_URL=http://127.0.0.1:8545 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HNSDNS/handover.git"
  },
  "keywords": [
    "Handshake",
    "HNS",
    "Ethereum",
    "ETH",
    "ENS",
    "NMC",
    "Helios"
  ],
  "author": "Matthew Zipkin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/imperviousinc/handover/issues"
  },
  "homepage": "https://github.com/HNSDNS/handover#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "peerDependencies": {
    "blru": "~0.1.8",
    "bns": "~0.16.0",
    "bufio": "~1.2.3",
    "hsd": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "blru": "~0.1.8",
    "bns": "~0.16.0",
    "bufio": "~1.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
